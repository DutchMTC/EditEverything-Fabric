{
  "schemaVersion": 1,
  "id": "ee",
  "version": "${version}",
  "name": "Edit Everything",
  "description": "Borried about the old minecraft stuff? This mod is made for you! it add new items modifiers for your creative mode. Based on Advanced Creative Tab by ATE47.",
  "authors": [
    "DutchMTC",
    "ATE47 (Creator of AdvancedCreativeTab)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/edit-everything",
    "sources": "https://github.com/DutchMTC/EditEverything-Fabric",
    "issues": "https://github.com/DutchMTC/EditEverything-Fabric/issues"
  },
  "license": "LGPL-3.0",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.dutchmtc.ee.EEMod"
    ],
    "client": [
      "com.dutchmtc.ee.EEModClient"
    ],
    "modmenu": [
      "com.dutchmtc.ee.ModMenuIntegration"
    ]
  },
  "mixins": [
    "ee.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.152.1",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25"
  }
}
